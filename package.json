{
  "name": "pane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pane": "./dist/cli.js"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:server": "tsx watch bin/pane.ts . --dev",
    "dev:web": "vite",
    "build": "vite build && tsup",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "hono": "^4.13.12",
    "lucide-react": "^1.51.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
